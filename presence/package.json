{
  "name": "presence",
  "version": "0.9.1",
  "description": "Shared agentic-state bus and visualization realms for full-duplex human↔agent conversation with tool use. Face (incl. sheet ghost), orb, glow, identity, glyph, meter, textmode, echo, braille, terminal.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "review": "vite --config vite.config.demo.ts --host 127.0.0.1 --port 5188 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec": "tsx scripts/extract-golden.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "thinking-orbs-mega": "*"
  },
  "peerDependenciesMeta": {
    "thinking-orbs-mega": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "thinking-orbs-mega": "file:../thinking-orbs-mega",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "private": true
}
