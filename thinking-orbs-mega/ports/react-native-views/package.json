{
  "name": "react-native-thinking-orbs",
  "version": "0.1.0",
  "description": "Animated dotted thinking orbs for React Native AI and voice interfaces",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/native/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./native": {
      "types": "./src/native/index.ts",
      "react-native": "./src/native/index.ts",
      "default": "./src/native/index.ts"
    },
    "./package.json": "./package.json"
  },
  "react-native": "./src/native/index.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build": "vite build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "clsx": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "react",
    "loading",
    "loader",
    "spinner",
    "ai",
    "agent",
    "llm",
    "react-native",
    "ios",
    "android",
    "canvas",
    "animation",
    "dark-mode"
  ],
  "author": "Shrit Shrivastava",
  "contributors": [
    "Jakub Antalik",
    "Alex Brinza"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shrit1401/react-native-thinking-orbs.git"
  },
  "bugs": {
    "url": "https://github.com/Shrit1401/react-native-thinking-orbs/issues"
  },
  "homepage": "https://github.com/Shrit1401/react-native-thinking-orbs#readme",
  "publishConfig": {
    "access": "public"
  }
}
