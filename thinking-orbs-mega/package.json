{
  "name": "thinking-orbs-mega",
  "version": "0.4.0",
  "description": "Megafork of thinking-orbs 0.3.1 — official nine plus fork extras and Conversation Seam. Not the official thinking-orbs package.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine.es.js"
      },
      "require": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "GLOSSARY.md",
    "SOURCES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "review": "node scripts/review-web.mjs",
    "review:ports": "node scripts/review-web.mjs --ports",
    "build": "vite build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "spec": "tsx scripts/extract-spec.ts && tsx scripts/extract-golden.ts",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run smoke && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "react",
    "loading",
    "orb",
    "ai",
    "agent",
    "voice",
    "canvas",
    "animation",
    "thinking-orbs"
  ],
  "author": "Fox9 / voidfab",
  "contributors": [
    "Jakub Antalik (thinking-orbs 0.3.1)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidfab/orbs.git",
    "directory": "thinking-orbs-mega"
  },
  "private": true,
  "publishConfig": {
    "access": "public"
  }
}
